{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "images.raw",
  "type": "object",
  "required": ["version", "timestamp", "GUID_Solicitud", "Id_Imagen", "s3_key"],
  "properties": {
    "version": { "type": "string" },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "GUID_Solicitud": {
      "type": "string",
      "format": "uuid"
    },

    "Id_Imagen": {
      "type": "integer"
    },

    "s3_key": {
      "type": "string",
      "description": "Ruta imagen original en MinIO"
    }
  },
  "additionalProperties": false
}