{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "evt.pixelation.completed",
  "type": "object",
  "required": ["version", "timestamp", "GUID_Solicitud", "Id_Imagen", "s3_key", "faces"],
  "properties": {
    "version": { "type": "string" },

    "timestamp": {
      "type": "string",
      "format": "date-time"
    },

    "GUID_Solicitud": { "type": "string", "format": "uuid" },

    "Id_Imagen": { "type": "integer" },

    "s3_key": { "type": "string" },

    "faces": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["face_id", "bbox", "es_menor"],
        "properties": {
          "face_id": { "type": "integer" },

          "s3_key_cara": { "type": "string" },

          "bbox": {
            "type": "object",
            "required": ["x", "y", "w", "h"],
            "properties": {
              "x": { "type": "integer" },
              "y": { "type": "integer" },
              "w": { "type": "integer" },
              "h": { "type": "integer" }
            }
          },

          "es_menor": { "type": "boolean" }
        }
      }
    }
  },
  "additionalProperties": false
}