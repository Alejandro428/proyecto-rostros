# ====================================
# Variables de entorno del proyecto.
#
# Estos valores funcionan tal cual para desarrollo local con docker compose.
# Solo abren las bases de datos y el bucket MinIO que arranca el propio
# compose: no protegen ningun sistema real. Si quieres cambiarlos, edita
# este archivo (o crea un .env aparte) - los servicios prefieren .env si
# existe.
# ====================================

# ====================================
# BASE DE DATOS
# ====================================
DB_HOST=db
DB_NAME=db_rostros
DB_USER=postgres
DB_PASSWORD=postgres

# ====================================
# KAFKA
# ====================================
KAFKA_SERVER=kafka:9092

# ====================================
# MINIO (S3)
# ====================================
MINIO_ENDPOINT=http://minio:9000
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# ====================================
# API-1
# ====================================
MAX_FILE_SIZE=10485760

# ====================================
# PYTHON
# ====================================
PYTHONUNBUFFERED=1
